# Node backend only. Never put this in browser code.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_growth_os?replicaSet=rs0
PORT=4000
APP_ORIGINS=http://localhost:3000
NODE_ENV=development
# Bootstrap database indexes before first traffic; later use release migrations.
INIT_INDEXES=true

# Verified sender and HTTPS frontend origin required for live email delivery.
PUBLIC_APP_URL=http://localhost:3000
EMAIL_FROM=
RESEND_API_KEY=

# Shared counters required before scaling beyond one API instance.
RATE_LIMIT_STORE=memory
REDIS_URL=
# Explicit trusted proxy IPs/CIDRs only; blank ignores forwarded client IPs.
TRUST_PROXY=
AUDIT_EXPORT_LIMIT=1000
# Blank means retain indefinitely. Purge is a separate dry-run-first operator job.
AUDIT_RETENTION_DAYS=

# Enable only after queue + independently running worker have passed acceptance.
CRAWLER_ENABLED=false
# external: dedicated worker; embedded: supervised API child, 20 pages, one job, no JS
CRAWLER_EXECUTION_MODE=dedicated
# Legacy CRAWLER_EXECUTION=external remains supported; do not set conflicting modes.
CRAWLER_RENDER_JS=false
# Worker uses the same MONGODB_URI and REDIS_URL. Install Chromium only if JS rendering is enabled.
