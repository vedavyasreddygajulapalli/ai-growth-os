# Node backend only. Never put this in browser code.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_growth_os?replicaSet=rs0
PORT=4000
APP_ORIGINS=http://localhost:3000
NODE_ENV=development
# Bootstrap database indexes before first traffic; later use release migrations.
INIT_INDEXES=true

# Verified sender and HTTPS frontend origin required for live email delivery.
PUBLIC_APP_URL=http://localhost:3000
EMAIL_FROM=
RESEND_API_KEY=
